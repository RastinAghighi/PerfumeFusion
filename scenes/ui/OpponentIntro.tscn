[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/ui/OpponentIntro.gd" id="1_script"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_portrait"]
bg_color = Color(0.18, 0.14, 0.25, 1)
corner_radius_top_left = 12
corner_radius_top_right = 12
corner_radius_bottom_right = 12
corner_radius_bottom_left = 12

[node name="OpponentIntro" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("1_script")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0, 0, 0, 0.75)

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="VBox" type="VBoxContainer" parent="Center"]
custom_minimum_size = Vector2(420, 0)
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 10

[node name="ChallLabel" type="Label" parent="Center/VBox"]
layout_mode = 2
mouse_filter = 2
theme_override_colors/font_color = Color(0.65, 0.6, 0.75, 1)
theme_override_font_sizes/font_size = 14
text = "CHALLENGER APPROACHING"
horizontal_alignment = 1

[node name="Portrait" type="PanelContainer" parent="Center/VBox"]
custom_minimum_size = Vector2(100, 100)
layout_mode = 2
size_flags_horizontal = 4
mouse_filter = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_portrait")

[node name="InitialsLabel" type="Label" parent="Center/VBox/Portrait"]
layout_mode = 2
mouse_filter = 2
theme_override_colors/font_color = Color(0.75, 0.65, 0.9, 1)
theme_override_font_sizes/font_size = 40
text = "??"
horizontal_alignment = 1
vertical_alignment = 1

[node name="NameLabel" type="Label" parent="Center/VBox"]
layout_mode = 2
mouse_filter = 2
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_font_sizes/font_size = 24
text = "Opponent Name"
horizontal_alignment = 1

[node name="TitleLabel" type="Label" parent="Center/VBox"]
layout_mode = 2
mouse_filter = 2
theme_override_colors/font_color = Color(0.7, 0.6, 0.85, 1)
theme_override_font_sizes/font_size = 14
text = "\"The Title\""
horizontal_alignment = 1

[node name="DescLabel" type="Label" parent="Center/VBox"]
custom_minimum_size = Vector2(420, 0)
layout_mode = 2
size_flags_horizontal = 4
mouse_filter = 2
theme_override_colors/font_color = Color(0.75, 0.72, 0.8, 1)
